{
  "name": "md2book",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read a folder of Markdown notes (an Obsidian vault works as-is) as a paginated two-column book.",
  "bin": {
    "md2book": "bin/md2book.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "start": "node bin/md2book.js"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "cheerio": "^1.1.2",
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "justif": "^0.9.1",
    "markdown-it": "^14.1.0",
    "markdown-it-mark": "^4.0.0",
    "temml": "^0.13.5"
  }
}
