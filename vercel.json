{
  "functions": {
    "api/index.js": {
      "includeFiles": "{static/**,node_modules/justif/{dist/**,LICENSE},node_modules/epubjs/{dist/**,license},node_modules/jszip/{dist/**,LICENSE.markdown},md2book.settings.json,notes/**}"
    }
  },
