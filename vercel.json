{
  "functions": {
    "api/index.js": {
      "includeFiles": "{static/**,node_modules/justif/{dist/**,LICENSE},node_modules/epubjs/{dist/**,license},node_modules/jszip/{dist/**,LICENSE.markdown},node_modules/@fontsource/noto-serif-sc/{400.css,700.css,LICENSE,files/*-400-normal.woff2,files/*-700-normal.woff2},md2book.settings.json,notes/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
