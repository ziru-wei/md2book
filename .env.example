# Read notes from a GitHub repository instead of a local folder: copy to
# .env for `npm run dev`, or set these as environment variables where the
# site is hosted (e.g. Vercel). OWNER, REPO and TOKEN must all be set to
# switch it on.

GITHUB_OWNER=your-github-name
GITHUB_REPO=your-notes-repo
GITHUB_BRANCH=main
# Comma-separated top-level folders to take notes from (recursively).
# Leave empty for the whole repo. Attachments are found anywhere.
GITHUB_DIRS=

# A personal access token that can read the repo above. Never commit it.
# A fine-grained token for just this repo, with only "Contents:
# Read-only", is the safest choice.
GITHUB_TOKEN=

# Optional: move the home page (the list of every note) to an
# unguessable path, e.g. HOME_PATH=/a1b2c3 — the plain "/" then shows
# nothing. Single notes and collections keep their own links. Same as
# site.homePath in md2book.config.js.
HOME_PATH=

# Optional: a token for a private repository that hosts images linked as
# raw.githubusercontent.com URLs (it can be a different account/repo from
# the notes). Those images are always served through this site's /img/
# route, so their real URL never reaches readers; leave empty if the
# images are public.
IMAGE_GITHUB_TOKEN=
