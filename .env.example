# Copy to .env for local testing against GitHub instead of the local
# entries/ folder, or set these as Vercel Environment Variables for
# deployment. All four must be set together to switch on GitHub mode.

GITHUB_OWNER=ziru-wei
GITHUB_REPO=personal-obsidian-repo-sync
GITHUB_BRANCH=main
# Comma-separated top-level folders to scan (recursively) for .md files.
# Leave empty to scan the whole repo.
GITHUB_DIRS=PhD,Journal

# Personal access token with read-only access to the repo above.
# Never commit this. Fine-grained tokens scoped to just this one repo,
# with only "Contents: Read-only" permission, are the safest choice —
# the repo holds private notes, so a broad classic token is overkill risk.
GITHUB_TOKEN=

# Optional: moves the listing pages off "/" entirely, e.g.
# HOME_PATH=/pw makes the journal live at /pw and /pw/contents
# instead. The real "/" then has no handler at all and just 404s,
# revealing nothing. Leave unset for local dev (defaults to "/").
HOME_PATH=
